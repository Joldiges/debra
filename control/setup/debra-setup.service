# Managed by Debra setup installer
#
# Rendered by control/setup/install.py from control/setup/debra-setup.service,
# which holds the five @PLACEHOLDER@ values. The installed copy is
# /etc/systemd/system/debra-setup.service. See README.md.
[Unit]
Description=Debra first-boot setup (device name, Wi-Fi onboarding, baseline)
# cloud-init rewrites /etc/hosts on Raspberry Pi OS, from its own template,
# during the boot. The writer is the stage that owns that module: cloud-init.service
# before 24.3 and cloud-init-network.service on 25.2's single-process design.
# Ordering after a unit that is not installed is ignored, so both names are
# listed. cloud-config.service and cloud-final.service are deliberately NOT used:
# they are ordered after network-online.target and, for cloud-final, after
# multi-user.target, which this unit is itself wanted by. Naming them would
# create an ordering cycle or delay the page until the network has timed out.
After=NetworkManager.service network.target cloud-init.service cloud-init-network.service
Wants=NetworkManager.service
# Three failures in five minutes is left failed rather than looping on port 80.
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=simple
# Runs as root: nmcli changes NetworkManager profiles and the hostname,
# raspi-config sets the regulatory domain, the setup page binds port 80, and the
# baseline reads root-only keyfiles. A user unit cannot do any of that at boot.
ExecStart=@PYTHON@ -B @RUNNER@ --serve --state-dir @STATE@ --card-note @CARD_NOTE@ --setup-security @SECURITY@
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
Restart=on-failure
RestartSec=5
TimeoutStopSec=10

[Install]
WantedBy=multi-user.target
