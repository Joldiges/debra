# IDEs
.idea/

# Project-local private records, recovery points, and generated artifacts
/.local/

# Generated per-task agent profiles from tools/coord.py: local coordination
# state, recreated per claim, never shared configuration.
/.opencode/agents/local-*.md

# Defensive guard for environment files; keep real values under .local/
.env
.env.*
!.env.example
!.env.*.example

# UniFi MCP audit log: contains full client inventories (MACs/hostnames/IPs).
# Kept untracked; sanitized copies belong in .local/.
/audit.jsonl

# unsorted
*.lock
*.bak

# Python bytecode
__pycache__/
*.pyc
