{
  "about": {"design": "rpispeaker-v17-cover", "format": "solidcraft/57", "provenance": "unreviewed bridge concept; body dimensions from v17 reconstruction; speaker is assumed"},
  "commands": [
    {"command":"parameters.add","params":{"name":"LAND_Y","expression":"8.5 mm","unit":"mm","comment":"Measured STEP pilot land"}},
    {"command":"parameters.add","params":{"name":"SHELF_Y","expression":"2.5 mm","unit":"mm","comment":"Measured STEP speaker floor"}},
    {"command":"parameters.add","params":{"name":"SPEAKER_H","expression":"15 mm","unit":"mm","comment":"ASSUMED total shelf-to-frame height; measure actual speaker"}},
    {"command":"parameters.add","params":{"name":"PLATE_Y","expression":"SHELF_Y + SPEAKER_H","unit":"mm","comment":"Assumed speaker contact level"}},
    {"command":"parameters.add","params":{"name":"COVER_T","expression":"3 mm","unit":"mm","comment":"ASSUMED plate thickness"}},
    {"command":"parameters.add","params":{"name":"MOUNT_X","expression":"32.5 mm","unit":"mm","comment":"Measured STEP pilot X"}},
    {"command":"parameters.add","params":{"name":"MOUNT_Z","expression":"18.25 mm","unit":"mm","comment":"Measured STEP pilot half-pitch"}},
    {"command":"parameters.add","params":{"name":"SQ_PITCH","expression":"32 mm","unit":"mm","comment":"ASSUMED square speaker mounting pitch"}},
    {"command":"parameters.add","params":{"name":"SQ_SCREW_D","expression":"2.7 mm","unit":"mm","comment":"ASSUMED speaker screw clearance"}},
    {"command":"parameters.add","params":{"name":"PLATE_W","expression":"SQ_PITCH + 6 mm","unit":"mm","comment":"3 mm edge distance from assumed square axes"}},
    {"command":"parameters.add","params":{"name":"PLATE_L","expression":"2*MOUNT_Z + 10 mm","unit":"mm","comment":"Pilot span plus 5 mm at each end"}},
    {"command":"parameters.add","params":{"name":"FOOT_D","expression":"8 mm","unit":"mm","comment":"ASSUMED round foot diameter"}},
    {"command":"parameters.add","params":{"name":"ANCHOR_D","expression":"4.6 mm","unit":"mm","comment":"Cover clearance larger than body cone, not the body screw size"}},
    {"command":"parameters.add","params":{"name":"CONE_RELIEF_D","expression":"4.8 mm","unit":"mm","comment":"Bottom relief slightly larger than the measured 4.5 mm body cone"}},
    {"command":"parameters.add","params":{"name":"CONE_RELIEF_DEPTH","expression":"0.5 mm","unit":"mm","comment":"ASSUMED underside relief depth"}},
    {"command":"parameters.add","params":{"name":"HEAD_D","expression":"6.5 mm","unit":"mm","comment":"ASSUMED top screw-head counterbore; actual fastener unconfirmed"}},
    {"command":"parameters.add","params":{"name":"HEAD_DEPTH","expression":"1.2 mm","unit":"mm","comment":"ASSUMED top counterbore depth"}},
    {"command":"parameters.add","params":{"name":"ACOUSTIC_X","expression":"31.625 mm","unit":"mm","comment":"Measured STEP central acoustic axis"}},
    {"command":"parameters.add","params":{"name":"ACOUSTIC_D","expression":"20 mm","unit":"mm","comment":"Single open circular acoustic aperture"}},
    {"command":"solid.box","params":{"name":"Bridge plate","body_name":"Cover","operation":"new","corner":["MOUNT_X - PLATE_W/2","PLATE_Y","-PLATE_L/2"],"length":"PLATE_W","width":"COVER_T","height":"PLATE_L"}},
    {"command":"solid.cylinder","params":{"name":"Negative pilot foot","operation":"join","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","-MOUNT_Z"],"diameter":"FOOT_D","height":"PLATE_Y - LAND_Y"}},
    {"command":"solid.cylinder","params":{"name":"Positive pilot foot","operation":"join","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","MOUNT_Z"],"diameter":"FOOT_D","height":"PLATE_Y - LAND_Y"}},
    {"command":"solid.cylinder","params":{"name":"Acoustic opening","operation":"cut","targets":["Cover"],"axis":"Y","base":["ACOUSTIC_X","PLATE_Y","0"],"diameter":"ACOUSTIC_D","height":"COVER_T"}},
    {"command":"solid.cylinder","params":{"name":"Negative anchor clearance","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","-MOUNT_Z"],"diameter":"ANCHOR_D","height":"PLATE_Y + COVER_T - LAND_Y"}},
    {"command":"solid.cylinder","params":{"name":"Positive anchor clearance","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","MOUNT_Z"],"diameter":"ANCHOR_D","height":"PLATE_Y + COVER_T - LAND_Y"}},
    {"command":"solid.cylinder","params":{"name":"Negative cone clearance relief","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","-MOUNT_Z"],"diameter":"CONE_RELIEF_D","height":"CONE_RELIEF_DEPTH"}},
    {"command":"solid.cylinder","params":{"name":"Positive cone clearance relief","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","LAND_Y","MOUNT_Z"],"diameter":"CONE_RELIEF_D","height":"CONE_RELIEF_DEPTH"}},
    {"command":"solid.cylinder","params":{"name":"Negative anchor head counterbore","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","PLATE_Y + COVER_T - HEAD_DEPTH","-MOUNT_Z"],"diameter":"HEAD_D","height":"HEAD_DEPTH"}},
    {"command":"solid.cylinder","params":{"name":"Positive anchor head counterbore","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X","PLATE_Y + COVER_T - HEAD_DEPTH","MOUNT_Z"],"diameter":"HEAD_D","height":"HEAD_DEPTH"}},
    {"command":"solid.cylinder","params":{"name":"Square speaker screw negative X negative Z","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X - SQ_PITCH/2","PLATE_Y","-SQ_PITCH/2"],"diameter":"SQ_SCREW_D","height":"COVER_T"}},
    {"command":"solid.cylinder","params":{"name":"Square speaker screw positive X negative Z","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X + SQ_PITCH/2","PLATE_Y","-SQ_PITCH/2"],"diameter":"SQ_SCREW_D","height":"COVER_T"}},
    {"command":"solid.cylinder","params":{"name":"Square speaker screw negative X positive Z","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X - SQ_PITCH/2","PLATE_Y","SQ_PITCH/2"],"diameter":"SQ_SCREW_D","height":"COVER_T"}},
    {"command":"solid.cylinder","params":{"name":"Square speaker screw positive X positive Z","operation":"cut","targets":["Cover"],"axis":"Y","base":["MOUNT_X + SQ_PITCH/2","PLATE_Y","SQ_PITCH/2"],"diameter":"SQ_SCREW_D","height":"COVER_T"}}
  ]
}
