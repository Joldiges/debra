{
  "about": {"design":"rpispeaker-v17-lid", "format":"solidcraft/57", "replay":"solidcraft-cli run build-script.json"},
  "commands": [
    {"command":"parameters.add","params":{"name":"BAY_X_MIN","expression":"17.15 mm","unit":"mm","comment":"Supplied v17 second-bay X minimum; reported width conflicts with endpoints"}},
    {"command":"parameters.add","params":{"name":"BAY_X_MAX","expression":"48.25 mm","unit":"mm","comment":"Supplied v17 second-bay X maximum; endpoints span 31.10 mm"}},
    {"command":"parameters.add","params":{"name":"BAY_Z_MIN","expression":"-33 mm","unit":"mm","comment":"Supplied v17 second-bay Z minimum"}},
    {"command":"parameters.add","params":{"name":"BAY_Z_MAX","expression":"33 mm","unit":"mm","comment":"Supplied v17 second-bay Z maximum"}},
    {"command":"parameters.add","params":{"name":"FRONT_Y","expression":"15.50 mm","unit":"mm","comment":"Supplied v17 front plane"}},
    {"command":"parameters.add","params":{"name":"BAY_FLOOR_Y","expression":"8.50 mm","unit":"mm","comment":"Supplied second-bay floor; pads assume a flat floor at both pilot coordinates"}},
    {"command":"parameters.add","params":{"name":"MOUNT_X","expression":"32.5 mm","unit":"mm","comment":"Supplied v17 two pilot X coordinate"}},
    {"command":"parameters.add","params":{"name":"MOUNT_Z","expression":"18.25 mm","unit":"mm","comment":"Supplied v17 pilot Z coordinates are plus/minus this"}},
    {"command":"parameters.add","params":{"name":"CLEAR","expression":"0.3 mm","unit":"mm","comment":"ASSUMED clearance per side in X and Z"}},
    {"command":"parameters.add","params":{"name":"LID_R","expression":"12 mm","unit":"mm","comment":"ASSUMED inset corner radius; actual inner pocket radius is unknown"}},
    {"command":"parameters.add","params":{"name":"PLATE","expression":"1.6 mm","unit":"mm","comment":"ASSUMED lid plate thickness; task minimum"}},
    {"command":"parameters.add","params":{"name":"DRIVER_D","expression":"28 mm","unit":"mm","comment":"ASSUMED bare driver overall diameter; no exact driver selected or measured"}},
    {"command":"parameters.add","params":{"name":"DRIVER_DEPTH","expression":"10 mm","unit":"mm","comment":"ASSUMED bare driver body depth, not a published component value"}},
    {"command":"parameters.add","params":{"name":"DRIVER_CLEAR","expression":"0.2 mm","unit":"mm","comment":"ASSUMED radial clearance between driver and sleeve"}},
    {"command":"parameters.add","params":{"name":"SLEEVE_WALL","expression":"1.6 mm","unit":"mm","comment":"ASSUMED minimum sleeve radial wall"}},
    {"command":"parameters.add","params":{"name":"BACK_OPEN_D","expression":"24.8 mm","unit":"mm","comment":"ASSUMED rear opening leaves 1.6 mm radial seat under nominal 28 mm driver; terminals and vents unmeasured"}},
    {"command":"parameters.add","params":{"name":"PAD_SIZE","expression":"6 mm","unit":"mm","comment":"ASSUMED square rear screw pad size"}},
    {"command":"parameters.add","params":{"name":"PAD_DEPTH","expression":"FRONT_Y - PLATE - BAY_FLOOR_Y","unit":"mm","comment":"Derived so pads reach supplied floor; ASSUMED no raised bosses interfere"}},
    {"command":"parameters.add","params":{"name":"LID_PILOT_D","expression":"2 mm","unit":"mm","comment":"ASSUMED pilot for M2.5 screw threading into printed lid"}},
    {"command":"parameters.add","params":{"name":"CABLE_X","expression":"7 mm","unit":"mm","comment":"ASSUMED JST-PH plug slot X width; connector must be measured"}},
    {"command":"parameters.add","params":{"name":"CABLE_Z","expression":"4 mm","unit":"mm","comment":"ASSUMED JST-PH plug slot Z length; connector must be measured"}},
    {"command":"parameters.add","params":{"name":"CABLE_AT_Z","expression":"27 mm","unit":"mm","comment":"ASSUMED slot centre; actual cable exit unknown"}},
    {"command":"parameters.add","params":{"name":"LID_W","expression":"BAY_X_MAX - BAY_X_MIN - 2*CLEAR","unit":"mm","comment":"Derived from narrower supplied X endpoints and assumed clearance"}},
    {"command":"parameters.add","params":{"name":"LID_L","expression":"BAY_Z_MAX - BAY_Z_MIN - 2*CLEAR","unit":"mm","comment":"Derived from supplied Z endpoints and assumed clearance"}},
    {"command":"parameters.add","params":{"name":"LID_X","expression":"(BAY_X_MIN + BAY_X_MAX)/2","unit":"mm","comment":"Derived midpoint of supplied X endpoints"}},
    {"command":"parameters.add","params":{"name":"LID_Z","expression":"(BAY_Z_MIN + BAY_Z_MAX)/2","unit":"mm","comment":"Derived midpoint of supplied Z endpoints"}},
    {"command":"parameters.add","params":{"name":"POCKET_D","expression":"DRIVER_D + 2*DRIVER_CLEAR","unit":"mm","comment":"Derived sleeve internal diameter"}},
    {"command":"parameters.add","params":{"name":"SLEEVE_D","expression":"POCKET_D + 2*SLEEVE_WALL","unit":"mm","comment":"Derived sleeve external diameter"}},
    {"command":"timeline.add","params":{"feature":{"type":"box","id":1,"name":"Inset lid central band","operation":"new_body","centred":true,"corner":["LID_X","FRONT_Y - PLATE/2","LID_Z"],"length":"LID_W","width":"PLATE","height":"LID_L - 2*LID_R","body_names":["Lid"]}}},
    {"command":"timeline.add","params":{"feature":{"type":"box","id":2,"name":"Inset lid end band","operation":"join","participants":["Lid"],"centred":true,"corner":["LID_X","FRONT_Y - PLATE/2","LID_Z"],"length":"LID_W - 2*LID_R","width":"PLATE","height":"LID_L"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":3,"name":"Inset lid positive positive corner","operation":"join","participants":["Lid"],"axis":[0,1,0],"base":["LID_X + LID_W/2 - LID_R","FRONT_Y - PLATE","LID_Z + LID_L/2 - LID_R"],"radius":"LID_R","height":"PLATE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":12,"name":"Inset lid negative positive corner","operation":"join","participants":["Lid"],"axis":[0,1,0],"base":["LID_X - LID_W/2 + LID_R","FRONT_Y - PLATE","LID_Z + LID_L/2 - LID_R"],"radius":"LID_R","height":"PLATE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":13,"name":"Inset lid positive negative corner","operation":"join","participants":["Lid"],"axis":[0,1,0],"base":["LID_X + LID_W/2 - LID_R","FRONT_Y - PLATE","LID_Z - LID_L/2 + LID_R"],"radius":"LID_R","height":"PLATE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":14,"name":"Inset lid negative negative corner","operation":"join","participants":["Lid"],"axis":[0,1,0],"base":["LID_X - LID_W/2 + LID_R","FRONT_Y - PLATE","LID_Z - LID_L/2 + LID_R"],"radius":"LID_R","height":"PLATE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"box","id":4,"name":"Rear screw pad positive","operation":"join","participants":["Lid"],"centred":true,"corner":["MOUNT_X","FRONT_Y - PLATE - PAD_DEPTH/2","MOUNT_Z"],"length":"PAD_SIZE","width":"PAD_DEPTH","height":"PAD_SIZE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"box","id":5,"name":"Rear screw pad negative","operation":"join","participants":["Lid"],"centred":true,"corner":["MOUNT_X","FRONT_Y - PLATE - PAD_DEPTH/2","-MOUNT_Z"],"length":"PAD_SIZE","width":"PAD_DEPTH","height":"PAD_SIZE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":6,"name":"External speaker sleeve stock","operation":"join","participants":["Lid"],"axis":[0,1,0],"base":["MOUNT_X","FRONT_Y","LID_Z"],"radius":"SLEEVE_D/2","height":"DRIVER_DEPTH"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":7,"name":"Open speaker sleeve","operation":"cut","participants":["Lid"],"axis":[0,1,0],"base":["MOUNT_X","FRONT_Y","LID_Z"],"radius":"POCKET_D/2","height":"DRIVER_DEPTH"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":8,"name":"Speaker rear opening","operation":"cut","participants":["Lid"],"axis":[0,1,0],"base":["MOUNT_X","FRONT_Y - PLATE","LID_Z"],"radius":"BACK_OPEN_D/2","height":"PLATE"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":9,"name":"Positive existing pilot alignment","operation":"cut","participants":["Lid"],"axis":[0,1,0],"base":["MOUNT_X","FRONT_Y - PLATE - PAD_DEPTH","MOUNT_Z"],"radius":"LID_PILOT_D/2","height":"PLATE + PAD_DEPTH"}}},
    {"command":"timeline.add","params":{"feature":{"type":"cylinder","id":10,"name":"Negative existing pilot alignment","operation":"cut","participants":["Lid"],"axis":[0,1,0],"base":["MOUNT_X","FRONT_Y - PLATE - PAD_DEPTH","-MOUNT_Z"],"radius":"LID_PILOT_D/2","height":"PLATE + PAD_DEPTH"}}},
    {"command":"timeline.add","params":{"feature":{"type":"box","id":11,"name":"JST connector opening","operation":"cut","participants":["Lid"],"centred":true,"corner":["MOUNT_X","FRONT_Y - PLATE/2","CABLE_AT_Z"],"length":"CABLE_X","width":"PLATE","height":"CABLE_Z"}}}
  ]
}
