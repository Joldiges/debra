# Pinned local workarounds for the Pi Zero W (ARMv6).
# Sourced by the scripts in this directory. Each pin names upstream work that
# retires it; see README.md. Do not edit these values without updating the
# SHA-256 check and recording why.

# The released tag the device runs. The stop-word patch is shaped for this tag.
LVA_TAG=v1.1.18

# ARMv6 libtensorflowlite_c.so, taken from the piwheels/sdist packaging fix.
# Upstream: https://github.com/OHF-Voice/pymicro-wakeword/pull/22
PW_REPO=https://github.com/Joldiges/pymicro-wakeword.git
PW_SHA=6bb5e6f37eb9f80ef673cd99c2d0575f181d7ec7
PW_LIB_PATH=lib/linux_armv6l/libtensorflowlite_c.so
PW_LIB_SHA256=ebd41e4311db3218fa8a0d623602d53e500ab76652b38a1a1b5fa83165d238c8

# Stop-word gating patch. Upstream:
# https://github.com/OHF-Voice/linux-voice-assistant/pull/526
LVA_PATCH=patches/0001-gate-idle-stop-word-v1.1.18.patch
